{
  "name": "pelham-civic-guide-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the Pelham Civic Guide (https://pelhamengagementproject.netlify.app/)",
  "scripts": {
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "verify:sources": "node scripts/build.js --verify-sources",
    "test": "playwright test --config=tests/playwright.config.js",
    "test:local": "npm run build && playwright test --config=tests/playwright.config.local.js",
    "test:ui": "playwright test --config=tests/playwright.config.js ui.spec.js",
    "test:ai": "playwright test --config=tests/playwright.config.js ai.spec.js",
    "test:headed": "playwright test --config=tests/playwright.config.js --headed",
    "test:list": "playwright test --config=tests/playwright.config.js --list"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
